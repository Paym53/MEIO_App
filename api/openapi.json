        }
       }
      }
     }
    },
    "security": [
     {
      "HTTPBearer": []
     }
    ]
   }
  },
  "/validate": {
   "post": {
    "summary": "Validate",
    "description": "Checks a workbook with the engine's own data checks. Nothing is stored.",
    "operationId": "validate_validate_post",
    "requestBody": {
     "content": {
      "multipart/form-data": {
       "schema": {
        "$ref": "#/components/schemas/Body_validate_validate_post"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Validation"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    },
    "security": [
     {
      "HTTPBearer": []
     }
    ]
   }
  },
  "/whatif/validate": {
   "post": {
    "summary": "Validate Whatif",
    "description": "Writes the edits into a copy of the original run's workbook and checks the copy with the engine's own checks.\nNothing is stored; the original is only read (W01). Errors are the engine's words (sheet, row, field).",
    "operationId": "validate_whatif_whatif_validate_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/WhatIf"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/WhatIfValidation"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    },
    "security": [
     {
      "HTTPBearer": []
     }
    ]
   }
  },
  "/runs": {
   "get": {
    "summary": "List Runs",
    "description": "Run history, newest first (runs made with the current engine only).",
    "operationId": "list_runs_runs_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/RunSummary"
         },
         "type": "array",
         "title": "Response List Runs Runs Get"
        }
       }
      }
     }
    },
    "security": [
     {
      "HTTPBearer": []
     }
    ]
   },
   "post": {
    "summary": "Create Run",
    "description": "Starts an optimization run in the background (refused while another run is in progress), either on an uploaded\nworkbook (file) or as a what-if: base_run = an original run, edits = JSON list of edits (see POST /whatif/validate);\nan invalid what-if is refused with the engine's errors (422) and starts nothing.\nnum_scenarios / random_seed replace the Excel NumScenarios / RandomSeed for this run only (engine rule K20).\nThe fill-rate target and the review period come from the workbook only (W04).",
    "operationId": "create_run_runs_post",
    "requestBody": {
     "content": {
      "multipart/form-data": {
       "schema": {
        "$ref": "#/components/schemas/Body_create_run_runs_post"
       }
      }
     }
    },
    "responses": {
     "202": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/RunStatus"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    },
    "security": [
     {
      "HTTPBearer": []
     }
    ]
   }
  },
  "/runs/{run_id}": {
   "get": {
    "summary": "Get Run",
