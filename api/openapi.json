      },
      "type": "array",
      "title": "Rules Missed Out Of Sample"
     },
     "feasibility": {
      "type": "string",
      "title": "Feasibility"
     },
     "bound_note": {
      "type": "string",
      "title": "Bound Note"
     },
     "cost_in_sample": {
      "type": "number",
      "title": "Cost In Sample"
     },
     "rules_met_in_sample": {
      "type": "integer",
      "title": "Rules Met In Sample"
     },
     "start_policy_cost": {
      "type": "number",
      "title": "Start Policy Cost"
     },
     "scenarios_in_sample": {
      "type": "integer",
      "title": "Scenarios In Sample"
     },
     "scenarios_out_of_sample": {
      "type": "integer",
      "title": "Scenarios Out Of Sample"
     },
     "seeker_status": {
      "type": "string",
      "title": "Seeker Status"
     }
    },
    "type": "object",
    "required": [
     "cost_out_of_sample",
     "rules_total",
     "rules_met_out_of_sample",
     "rules_missed_out_of_sample",
     "feasibility",
     "bound_note",
     "cost_in_sample",
     "rules_met_in_sample",
     "start_policy_cost",
     "scenarios_in_sample",
     "scenarios_out_of_sample",
     "seeker_status"
    ],
    "title": "Headline"
   },
   "Health": {
    "properties": {
     "status": {
      "type": "string",
      "title": "Status"
     },
     "engine_version": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Engine Version"
     },
     "license_found": {
      "type": "boolean",
      "title": "License Found"
     },
     "busy": {
      "type": "boolean",
      "title": "Busy"
     },
     "current_run": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Current Run"
     },
     "test_double": {
      "type": "boolean",
      "title": "Test Double"
     }
    },
    "type": "object",
    "required": [
     "status",
     "engine_version",
     "license_found",
     "busy",
     "current_run",
     "test_double"
    ],
    "title": "Health"
   },
   "MissedRule": {
    "properties": {
     "channel": {
      "type": "string",
      "title": "Channel"
     },
     "week": {
      "type": "integer",
      "title": "Week"
     },
     "target": {
      "type": "number",
      "title": "Target"
     },
     "share": {
      "type": "number",
      "title": "Share"
     }
    },
    "type": "object",
    "required": [
     "channel",
     "week",
     "target",
     "share"
    ],
    "title": "MissedRule"
   },
   "Result": {
    "properties": {
     "contract_version": {
      "type": "integer",
      "title": "Contract Version"
     },
     "engine_version": {
      "type": "string",
      "title": "Engine Version"
     },
     "seeker_version": {
      "type": "string",
      "title": "Seeker Version"
     },
     "test_double": {
      "type": "boolean",
      "title": "Test Double"
     },
     "headline": {
      "$ref": "#/components/schemas/Headline"
     },
     "sheets": {
      "additionalProperties": {
       "$ref": "#/components/schemas/Table"
      },
      "type": "object",
      "title": "Sheets"
     },
     "timings": {
      "items": {
       "prefixItems": [
        {
         "type": "string"
        },
        {
         "type": "number"
        }
       ],
       "type": "array",
       "maxItems": 2,
       "minItems": 2
      },
      "type": "array",
      "title": "Timings"
     }
    },
    "type": "object",
    "required": [
     "contract_version",
     "engine_version",
     "seeker_version",
     "test_double",
     "headline",
     "sheets",
     "timings"
    ],
    "title": "Result"
   },
   "RunStatus": {
    "properties": {
     "id": {
      "type": "string",
      "title": "Id"
     },
     "state": {
      "type": "string",
      "title": "State"
     },
     "created": {
      "type": "string",
      "title": "Created"
     },
     "finished": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Finished"
     },
     "time_limit": {
      "type": "number",
      "title": "Time Limit"
     },
     "message": {
      "type": "string",
      "title": "Message"
     },
     "summary": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Summary"
     },
     "test_double": {
      "type": "boolean",
      "title": "Test Double",
      "default": false
     },
     "errors": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Errors"
     },
     "phase": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Phase"
     },
     "seconds_left": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Seconds Left"
     },
     "log_tail": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Log Tail"
     }
    },
    "type": "object",
    "required": [
     "id",
     "state",
     "created",
     "finished",
     "time_limit",
     "message",
     "errors",
     "phase",
     "seconds_left",
     "log_tail"
    ],
    "title": "RunStatus"
   },
   "RunSummary": {
    "properties": {
     "id": {
      "type": "string",
      "title": "Id"
     },
     "state": {
      "type": "string",
      "title": "State"
     },
     "created": {
      "type": "string",
      "title": "Created"
     },
     "finished": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Finished"
     },
     "time_limit": {
      "type": "number",
      "title": "Time Limit"
     },
     "message": {
      "type": "string",
      "title": "Message"
     },
     "summary": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Summary"
     },
     "test_double": {
      "type": "boolean",
      "title": "Test Double",
      "default": false
     }
    },
    "type": "object",
    "required": [
     "id",
     "state",
     "created",
     "finished",
     "time_limit",
     "message"
    ],
    "title": "RunSummary"
   },
   "Table": {
    "properties": {
     "columns": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Columns"
     },
     "rows": {
      "items": {
       "items": {},
       "type": "array"
      },
      "type": "array",
      "title": "Rows"
     }
    },
    "type": "object",
    "required": [
     "columns",
     "rows"
    ],
    "title": "Table"
   },
   "Validation": {
    "properties": {
     "valid": {
      "type": "boolean",
      "title": "Valid"
     },
     "errors": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Errors"
     }
    },
    "type": "object",
    "required": [
